# Production environment for apps/api, consumed via docker-compose's `env_file`.
#
# Unlike local dev, nothing here is inherited from a parent shell or from
# packages/database/.env — .dockerignore excludes all .env files from the
# build, and apps/api/src/index.ts only loads THIS file. DATABASE_URL and
# REDIS_URL must be set explicitly here even though they're normally implicit
# in local dev.

# Server
PORT=3001
NODE_ENV=production

# Frontend & Auth — must be the real production domains, not localhost.
# Better Auth is configured with sameSite:"none", secure:true cookies, so both
# sides MUST be served over HTTPS or auth will silently fail.
FRONTEND_URL="https://<your-vercel-domain>"
BETTER_AUTH_URL="https://api.<your-domain>"
BETTER_AUTH_SECRET="your-secret-here" # openssl rand -base64 32 — reuse dev's or rotate, your call

# Social sign-in (optional — only registered if both id+secret are set).
# Redirect/callback URIs registered with each provider must point at the
# PRODUCTION domain, not localhost:
#   Google: https://api.<your-domain>/api/auth/callback/google
#   GitHub: https://api.<your-domain>/api/auth/callback/github
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Database — Neon connection string (dev DB reused for prod, per your call)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&connect_timeout=10"

# Redis — "redis" is the docker-compose service name, resolved on the internal
# Docker network. Do NOT use localhost here — there is no Redis on the api
# container's own localhost.
REDIS_URL="redis://redis:6379"

# AI Services — SCRIPT_PROVIDER is "gemini"; OpenAI key is currently invalid
# and unused at that setting, kept here only so the code path doesn't throw
# if SCRIPT_PROVIDER is ever flipped back to "openai".
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"
SCRIPT_PROVIDER="gemini" # Options: 'openai' (gpt-4-turbo), 'gemini' (gemini-2.5-flash)

# TTS
TTS_PROVIDER="unreal" # Options: 'unreal', 'elevenlabs'
UNREAL_SPEECH_API_KEY="your-unreal-speech-api-key-here"
ELEVENLABS_API_KEY="sk_your-elevenlabs-api-key-here"

# AWS / S3 — the NEW bucket, with an IAM user/role scoped to just this bucket
# (PutObject/GetObject/DeleteObject/ListBucket), not an admin key.
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="your-new-bucket-name"

# Dodo Payments — set DODO_PAYMENTS_ENVIRONMENT to live_mode when ready, and
# register https://api.<your-domain>/api/v1/billing/webhook in the Dodo dashboard.
DODO_PAYMENTS_API_KEY="your-dodo-api-key-here"
DODO_PAYMENTS_WEBHOOK_KEY="your-dodo-webhook-secret-here"
DODO_PAYMENTS_ENVIRONMENT="test_mode" # Options: 'test_mode', 'live_mode'
DODO_PAYMENTS_RETURN_URL="https://<your-vercel-domain>/dashboard/settings/billing/success"
DODO_PRODUCT_STARTER="pdt_your_starter_product_id"
DODO_PRODUCT_PRO="pdt_your_pro_product_id"
DODO_PRODUCT_BUSINESS="pdt_your_business_product_id"

# Admin
ADMIN_EMAILS="admin@example.com" # Comma-separated
