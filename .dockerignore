# Applies repo-wide since docker-compose.yml builds with context: .

# Dependencies
node_modules
**/node_modules

# Build artifacts
dist
build
.turbo
.next

# Environment files (never bake into image). MUST use **/ — unlike
# .gitignore, a bare pattern here only matches the context root, not nested
# paths like apps/api/.env or packages/database/.env (which is exactly what
# COPY apps/api ./apps/api and COPY packages/database ./packages/database
# pull in wholesale — a bare ".env" pattern silently let both through).
**/.env
**/.env.*
!**/.env.example

# Git & editor
.git
.gitignore
.vscode
.idea

# OS artifacts
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test files
**/*.test.ts
**/*.spec.ts
coverage

# Docs
*.md

# Misc project scratch not needed at build time
other
docs
